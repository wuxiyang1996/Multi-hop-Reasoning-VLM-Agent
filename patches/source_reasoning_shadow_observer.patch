diff --git a/scripts/run_instrumented_source_smoke.py b/scripts/run_instrumented_source_smoke.py
--- a/scripts/run_instrumented_source_smoke.py
+++ b/scripts/run_instrumented_source_smoke.py
@@ -220,6 +220,26 @@ class LocalCheckpointRolloutActor:
                 raise RuntimeError(f"checkpoint_adapter_empty_response:{adapter}")
         return result
 
+    async def generate_chat(
+        self, messages, *, adapter=None, temperature=None,
+        max_tokens=None, stop=None, extra_body=None,
+    ):
+        result = await self._client.generate_chat(
+            messages,
+            adapter=adapter,
+            temperature=temperature,
+            max_tokens=max_tokens,
+            stop=stop,
+            extra_body=extra_body,
+        )
+        self.calls.append({
+            "requested_adapter": adapter,
+            "used_adapter": result.adapter,
+            "nonempty_response": bool(result.text.strip()),
+            "mode": "chat",
+        })
+        return result
+
     async def close(self) -> None:
         for client in self._client._clients:  # owned clients; no public close API
             await client.close()
