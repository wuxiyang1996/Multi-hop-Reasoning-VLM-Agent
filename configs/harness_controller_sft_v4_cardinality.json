  "cardinality_induction": {
    "kind": "SOURCE_PROGRAM_SYMMETRY_CLOSURE",
    "subsets": "retain the source-program ranked prefix and alpha-rename opaque candidate IDs",
    "extensions": "append only zero-effect dominated candidates",
    "labels": "recompute every decision, binding, reason, and next state with the frozen source executor",
    "matched_boundary_controls": "for arities 2 and 3 add tied and missing-schema states; for arity 2 add the corresponding singleton boundary",
    "target_candidate_counts_read": false,
    "target_examples_read": false
  },
  "claim_boundary": "SOURCE_ONLY_CONTROLLER_SFT_V4_CARDINALITY;ARITY_2_TO_12_FROM_SOURCE_PROGRAM_SYMMETRIES;NO_TARGET_DATA;NO_NATIVE_ACTIONS;NO_HAND_AUTHORED_TARGET_LABELS"
