    },
    "gymv_columns": {
      "primary_horizon": 50,
      "split": "validation"
    },
    "gymv_streets_of_rage_2": {
      "primary_horizon": 50,
      "split": "train"
    },
    "gymv_strider": {
      "primary_horizon": 22,
      "split": "train"
    },
    "gymv_thunder_force_iii": {
      "primary_horizon": 23,
      "rows_root": "runs/phase3_typed_effect_source_reserve_v2",
      "split": "source_held_out"
    },
    "tetris": {
      "primary_horizon": 16,
      "split": "train"
    }
  },
  "split_policy": {
    "kind": "WHOLE_SOURCE_FAMILY_HELD_OUT_WITH_ARITY_GRID",
    "train_rows": "development_rows_root",
    "validation_rows": "fresh_reserve_rows_root",
    "source_held_out_rows": "gymv_thunder_force_iii frozen reserve",
    "target_rows": 0
  },
  "controls": [
    "DETERMINISTIC_EFFECT_BINDING_SHUFFLE",
    "NONUNIQUE_ARGMAX_CONTROL",
    "SINGLETON_CANDIDATE_CONTROL",
    "MISSING_TYPED_EFFECT_CONTROL",
