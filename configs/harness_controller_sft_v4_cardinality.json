    "CARDINALITY_EQUIVARIANT_EFFECT_ROTATION",
    "CARDINALITY_EQUIVARIANT_TIED_CONTROL",
    "CARDINALITY_EQUIVARIANT_MISSING_SCHEMA_CONTROL",
    "CARDINALITY_EQUIVARIANT_SINGLETON_BOUNDARY"
