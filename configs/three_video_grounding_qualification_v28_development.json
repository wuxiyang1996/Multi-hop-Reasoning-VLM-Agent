{
  "schema_version": 28,
  "status": "DEVELOPMENT_GROUNDING_QUALIFICATION_ONLY",
  "claim_boundary": "Source-free, already-consumed adaptation pilot. The runtime grounder sees public questions, public candidate concepts, wrapper pixel-transition proposals, and proxy frames, but no gold labels, functional programs, STAR situation graphs, source skills, or source symbolic structure. Gold and oracle annotations are attached only after all matched branches freeze.",
  "manifest": "/fs/gamma-projects/vlm-robot/Multi-hop-Reasoning-VLM-Agent-two-agent-clean/configs/three_video_grounding_qualification_v28_manifest.json",
  "wrapper_root": "/fs/gamma-projects/vlm-robot/Multi-hop-Reasoning-VLM-Agent",
  "benchmarks": {
    "clevrer": {
      "root": "/fs/gamma-projects/vlm-robot/Multi-hop-Reasoning-VLM-Agent/data/CLEVRER",
      "annotation_split": "validation"
    },
    "star": {
      "root": "/fs/gamma-projects/vlm-robot/datasets/STAR-official",
      "annotation_split": "val"
    },
    "nextqa": {
      "root": "/fs/gamma-projects/vlm-robot/datasets/NExT-QA-official",
      "annotation_split": "val"
    }
  },
  "model": {
    "provider": "openrouter",
    "api_key_name": "OPENROUTER_API_KEY",
    "id": "openai/gpt-4.1-mini",
    "base_url": "https://openrouter.ai/api/v1",
    "timeout_seconds": 180,
    "max_retries": 2,
    "schema_retries": 2,
    "max_ground_tokens": 900,
    "max_answer_tokens": 500,
    "temperature": 0
  },
  "media": {
    "proxy_frame_count": 24,
    "proxy_frame_max_side": 512,
    "scout_frames_per_panel": 8,
    "scout_frame_width": 192,
    "answer_frame_count": 8,
    "answer_frame_width": 256,
    "jpeg_quality": 84
  },
  "grounding": {
    "transition_pair_count": 6,
    "uniform_anchor_count": 3,
    "pixel_change_threshold": 0.0,
    "semantic_tool": "ANSWER_FREE_CANDIDATE_CONDITIONED_EVENT_RECEIPT_V1",
    "receipt_fields": [
      "subject",
      "predicate",
      "object",
      "observability",
      "start_frame",
      "end_frame",
      "evidence_frames",
      "before_state",
      "after_state",
      "confidence",
      "uncertainties"
    ]
  },
  "conditions": [
    "uniform_direct",
    "uniform_receipt",
    "localized_direct",
    "localized_receipt",
    "shifted_receipt"
  ],
  "qualification_logic": {
    "localization_effect": "localized_direct - uniform_direct",
    "receipt_effect": "localized_receipt - localized_direct",
    "combined_effect": "localized_receipt - uniform_direct",
    "evidence_necessity": "localized_receipt - shifted_receipt",
    "intrinsic_star_metric": "gold_action_timestamp_hit",
    "clevrer_observability_metric": "future_or_counterfactual_not_claimed_as_fully_observed",
    "nextqa_metric": "matched QA evidence necessity"
  }
}
