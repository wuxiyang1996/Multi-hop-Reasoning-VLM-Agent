# COS-PLAY — Required API Keys
# Copy this file to .env and fill in your keys.
# Then export them: `set -a && source .env && set +a`

# ── Model stack (current phase) ─────────────────────────────────────────
# - Actor + skill-bank trained model: Qwen/Qwen3.5-9B   (vLLM)
# - Crafter / harness / orchestrator: Qwen/Qwen3.5-35B-A3B (vLLM, frozen)
# - Validation judge + SFT teacher:   gpt-5.5            (OpenAI / OpenRouter)
# See common/models.py for the canonical constants and override env-vars.

# OpenAI (for gpt-5.5 judge / SFT teacher and cold-start data generation)
OPENAI_API_KEY=sk-...

# Anthropic (for Claude baselines)
ANTHROPIC_API_KEY=sk-ant-...

# Google (for Gemini baselines)
GEMINI_API_KEY=AIza...

# OpenRouter (optional — unified API for all models; preferred for
# cold-start / SFT data generation when a single key is convenient).
OPENROUTER_API_KEY=sk-or-...

# vLLM (for local Qwen/Qwen3.5-9B actor + skill-bank inference during
# training and evaluation).  When the larger Qwen/Qwen3.5-35B-A3B
# control-plane backbone is also served (e.g. via
# inference/serve_qwen35_35b_a3b.sh), expose its endpoint via
# VLLM_BASE_URLS or pin a second URL here.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY

# Optional: override any tier of the backbone stack at process start.
# VLM_AGENT_BACKBONE_MODEL=Qwen/Qwen3.5-9B
# VLM_AGENT_BACKBONE_TEACHER_MODEL=Qwen/Qwen3.5-35B-A3B
# VLM_AGENT_BACKBONE_JUDGE_MODEL=gpt-5.5
# VLM_AGENT_BACKBONE_SFT_TEACHER_MODEL=gpt-5.5
